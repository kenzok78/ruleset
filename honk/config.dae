# ============================================================
# Honk 配置 · 完整版（AI 分组 + 国内外 DNS 分流）
# ============================================================
# Honk 是 dae 的 Rust + eBPF 重写，语法同源，但有三处结构性差异：
#   1. global / experimental 拆到 system.dae，用 include 引入
#   2. dns.upstream 定义时就绑定出口（default -> direct / remote -> Proxy）
#   3. 多 experimental.native_api 段（Doona 面板靠它连核心）
#   4. AI 按服务细分（OpenAI / Claude / Gemini / Muse），没有笼统的 AI 组
#
# 分流思路参考 qichiyuhub/rule 的 honk 配置：AI 站点逐个点名、Telegram 补 IP 段、
# 订阅走 assets 直连拉取；DoT 封闭与 !dport(53, 853) 也来自那边。
#
# 本文件的基线取自 252 上实际在跑的配置（不是包里的出厂默认值），
# 它比出厂默认多了：pname 规则、广告拦截、google-cn / 国服游戏直连、
# 带 interval + route 的订阅写法。
#
# 三个必须确认的地方：
#   1. subscription 换成你的订阅（只支持 v2ray/URL 格式）
#   2. system.dae 里的 lan_interface（x86 软路由一般是 br-lan）
#   3. group 里的地区正则，改成你节点名里真实出现的关键字
#
# 组名只能用英文和数字。
# ============================================================

include {
    system.dae
}

# ---------------- 订阅 ----------------
# honk 支持的写法：tag 后面跟 option block
#   interval  多久更新一次，单位必须带 s/m/h
#   route     下载订阅本身走哪条路，direct 表示直连拉取
# 只写一行 `sub: 'url'` 也能用，但拿不到这两个控制项。
subscription {
    kenzo_sub: 'https://example.com/sub' {
        interval: 86400s
        route: direct
    }
}

# 订阅、geodata 的下载策略。首次启动代理组还没节点，走代理会拉不下来，所以 route: direct。
# geo 数据沿用系统自带的 /usr/share/v2ray（OpenWrt 的 v2ray-geosite / v2ray-geoip 维护），
# 这里不要再写 geodata 源，否则会出现两份数据各自更新。
assets {
    route: direct
    subscription {
        ua: 'clash.meta/1.19.30'
        interval: 86400s
        cache: true
    }
}

# 手写节点示例（不想用订阅就打开这段）
# 一个 tag 只放一条链接。
#
# 注意：honk 不支持链式代理（dae 支持）。share-link 解析只取 "->" 之前的第一跳，
# 后面的 hop 会被静默丢弃、日志也不报错，所以不要把链式链接写进来。
# 需要链式代理请用 dae 内核装同一份配置。
# node {
#     my_vps: 'hysteria2://密码@vps.example.com:443/?sni=vps.example.com'
# }

# ---------------- 策略组 ----------------
# policy 可选：min_moving_avg（移动平均延迟最低，推荐）/ min_avg10 / min / random / fixed(n)
group {
    Proxy {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }

    # --- AI：每家单独一组，按需要换地区 ---
    # OpenAI / Gemini / Muse 走新加坡，Claude 走台湾（Anthropic 对新加坡/IP 友好，台湾节点绕开美国限流）
    OpenAI {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|Singapore') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Claude {
        filter: name(regex: '🇹🇼|TW|tw|台湾|台灣|Taiwan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Gemini {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|Singapore') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Muse {
        filter: name(regex: '🇸🇬|SG|sg|新加坡|狮城|Singapore') && !name(regex: '排除')
        policy: min_moving_avg
    }

    # --- 常用平台 ---
    Youtube {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Google {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Github {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Telegram {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    TikTok {
        filter: name(regex: '🇺🇸|US|us|美国|美|United States') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Netflix {
        filter: name(regex: '🇺🇸|US|us|美国|美|United States') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Wallet {
        filter: name(regex: '🇺🇸|US|us|美国|美|United States') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Steam {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Microsoft {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    OneDrive {
        filter: name(regex: '🇯🇵|JP|jp|日本|日|Japan') && !name(regex: '排除')
        policy: min_moving_avg
    }
    Apple {
        filter: name(regex: '🇭🇰|HK|hk|香港|港|HongKong') && !name(regex: '排除')
        policy: min_moving_avg
    }

    # 漏网之鱼：全部节点参与，用 score 按真实连接质量挑（比纯延迟更贴近体感）
    Final {
        filter: !name(regex: '官网|剩余|流量|套餐|免费|订阅|到期时间|直连|Expire Date|Traffic|ExpireDate')
        policy: score
    }
}

# ---------------- DNS ----------------
dns {
    upstream {
        # 国内 DNS 绑定 direct 出口
        default: 'https://223.5.5.5/dns-query?tls_server_name=dns.alidns.com' -> direct
        # 国外 DNS 绑定代理出口
        remote: 'https://8.8.8.8/dns-query?tls_server_name=dns.google' -> Proxy
    }
    routing {
        request {
            # 关掉 HTTPS/SVCB 与 AAAA，简化解析链路
            qtype(https, svcb) -> reject
            qtype(aaaa) -> reject

            # Google Play 商店靠这两个后缀，必须走国外 DNS，否则商店更新失败
            qname(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com) -> remote

            # asis = 原样放行，交给上游决定
            qname(geosite: private) -> asis
            # 国内域名走国内 DNS
            qname(geosite: cn, geosite: microsoft@cn, geosite: apple@cn) -> default
            # 国外域名走国外 DNS
            qname(geosite: geolocation-!cn) -> remote
            fallback: remote
        }
        response {
            # 国外 DNS 返回国内 IP（CDN 有国内节点）时，改用国内 DNS 重查，拿到就近节点
            upstream(remote) && ip(geoip: cn) -> default
            fallback: accept
        }
    }
}

# ---------------- 分流 ----------------
routing {
    # NetworkManager 自己的流量不代理
    pname(NetworkManager) -> direct
    # 组播地址不代理
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    # 封掉 DoT，防止 App 绕过核心自己加密解析
    dport(853) -> block
    # 局域网直连。!dport(53, 853) 是为了别把 DNS / DoT 请求当直连放过去
    dip(geoip: private) && !dport(53, 853) -> direct(must)
    # 拦掉 QUIC（443/UDP），强制回落 TCP，让按域名分流真正生效
    # 不想用就注释掉这行
    l4proto(udp) && dport(443) -> block

    # --- 广告 ---
    domain(geosite: category-ads-all) -> block

    # --- Google 中国服务 + 国服游戏，直接放行 ---
    domain(geosite: google-cn, geosite: category-games@cn) -> direct

    # --- AI：每家一个组，不用笼统的 AI 组 ---
    # OpenAI（含 ChatGPT 静态资源域，geosite: openai 偶尔漏掉新版域名）
    domain(geosite: openai, suffix: openai.com, suffix: chatgpt.com,
           suffix: oaistatic.com, suffix: oaiusercontent.com) -> OpenAI
    # Claude / Anthropic
    domain(geosite: anthropic, suffix: claude.ai, suffix: anthropic.com) -> Claude
    # Gemini 与 Google 自家的 AI 页面（NotebookLM 也在 Gemini 组）
    domain(geosite: google-gemini, suffix: gemini.google.com,
           suffix: notebooklm.google) -> Gemini
    # muse.ai 是 Meta 旗下产品，geosite 里还没有这个 code，所以手写域名
    domain(suffix: muse.ai) -> Muse
    # 其余 AI 站（Perplexity、Poe、Midjourney 等）不单独立组，归到 Proxy
    domain(geosite: category-ai-!cn) -> Proxy

    # --- 常用平台 ---
    domain(suffix: googleapis.cn, suffix: xn--ngstr-lra8j.com, suffix: withgoogle.com) -> Google
    domain(geosite: youtube) -> Youtube
    domain(geosite: google) -> Google
    domain(geosite: github) -> Github
    domain(geosite: onedrive) -> OneDrive
    domain(geosite: microsoft@cn) -> direct
    domain(geosite: microsoft) -> Microsoft
    domain(geosite: apple@cn) -> direct
    domain(geosite: apple) -> Apple
    domain(geosite: telegram) -> Telegram
    # 有些客户端直接连 Telegram 的 IP 段，域名规则兜不住
    dip(geoip: telegram) -> Telegram
    domain(geosite: tiktok) -> TikTok
    domain(geosite: netflix) -> Netflix
    domain(geosite: paypal, geosite: binance, geosite: okx, geosite: category-cryptocurrency) -> Wallet
    domain(geosite: steam@cn) -> direct
    domain(geosite: steam) -> Steam

    # --- 兜底 ---
    # 国内 IP 兜底放在域名规则之后。
    # 放到最上面的话，国外域名解析到国内 CDN 节点时会被误判成直连。
    domain(geosite: cn) -> direct
    dip(geoip: cn) && !dport(53, 853) -> direct(must)
    domain(geosite: geolocation-!cn) -> Proxy
    fallback: Final
}
